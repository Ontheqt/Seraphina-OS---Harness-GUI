{
  "description": "Local first (the owner's agreed routing): Flash-Next on TabbyAPI (EXL3 build first, then the Strata GGUF build; MiMo V2.6 Pro through NanoGPT when both are down or a slot is busy for 15 minutes) builds, codes, scouts and reviews security; the builder escalates on CHANGES to GPT-6.1 Sol high, then xhigh; GPT-6.1 Sol reviews code, Claude Sonnet 5.5 UX, Gemini 4 Argon UI; Claude Opus 5.5 high writes the spec, approves and leads. The factory never swaps the model Tabby has loaded (allow_model_swap off). Profiles: local-first, balanced, best, fastest, thrifty. Servers are 127.0.0.1 placeholders; NanoGPT model ids are unverified: run factory doctor to check them. Needs TABBY_API_KEY, STRATA_API_KEY (or /etc/ai-stack/strata.env) and NANOGPT_API_KEY.",
  "providers": {
    "tabby": {
      "type": "openai",
      "base_url": "http://127.0.0.1:5000/v1",
      "api_key_env": "TABBY_API_KEY",
      "auth": "both",
      "max_concurrency": 1,
      "concurrency_scope": "run",
      "timeout": 1800,
      "kind": "tabby",
      "allow_model_swap": false,
      "overflow_after_seconds": 900,
      "tokens_per_second": 90
    },
    "strata": {
      "type": "openai",
      "base_url": "http://127.0.0.1:18080/v1",
      "api_key_env": "STRATA_API_KEY",
      "api_key_file": "/etc/ai-stack/strata.env",
      "max_concurrency": 1,
      "concurrency_scope": "run",
      "timeout": 1800,
      "overflow_after_seconds": 900,
      "tokens_per_second": 70
    },
    "llamacpp": {
      "type": "openai",
      "base_url": "http://127.0.0.1:8080/v1",
      "api_key_env": null,
      "max_concurrency": 1,
      "concurrency_scope": "run",
      "timeout": 1800,
      "overflow_after_seconds": 900,
      "tokens_per_second": 25
    },
    "nanogpt": {
      "type": "openai",
      "base_url": "https://nano-gpt.com/api/v1",
      "api_key_env": "NANOGPT_API_KEY",
      "timeout": 900
    },
    "nanogpt-anthropic": {
      "type": "anthropic",
      "base_url": "https://nano-gpt.com/api",
      "api_key_env": "NANOGPT_API_KEY",
      "auth": "both",
      "timeout": 900
    }
  },
