{
  "description": "Claude only: Opus 5.5 (effort high), Sonnet 5.5 (effort medium) and Haiku 5.5 tiers with adaptive thinking, prompt caching and the server-side refusal fallback. Needs ANTHROPIC_API_KEY.",
  "providers": {
    "anthropic": {
      "type": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "headers": {
        "anthropic-beta": "server-side-fallback-2026-07-01"
      },
      "timeout": 900
    }
  },
  "models": {
    "opus": {
      "provider": "anthropic",
      "model": "claude-opus-5-5",
      "max_tokens": 64000,
      "context_tokens": 1000000,
      "stream": true,
      "allow_history_edits": false,
      "eager_tools": true,
      "extra_body": {
        "thinking": {
          "type": "adaptive",
          "display": "summarized"
        },
        "output_config": {
          "effort": "high"
        },
        "cache_control": {
          "type": "ephemeral"
        },
        "fallbacks": "default"
      }
    },
    "sonnet": {
      "provider": "anthropic",
      "model": "claude-sonnet-5-5",
      "max_tokens": 64000,
      "context_tokens": 1000000,
      "stream": true,
      "allow_history_edits": false,
      "eager_tools": true,
      "extra_body": {
        "thinking": {
          "type": "adaptive",
          "display": "summarized"
        },
        "output_config": {
          "effort": "medium"
        },
        "cache_control": {
          "type": "ephemeral"
        },
        "fallbacks": "default"
      }
    },
    "haiku": {
      "provider": "anthropic",
      "model": "claude-haiku-5-5",
      "max_tokens": 64000,
      "context_tokens": 1000000,
      "stream": true,
      "allow_history_edits": false,
      "eager_tools": true,
      "extra_body": {
        "thinking": {
          "type": "adaptive",
          "display": "summarized"
        },
        "output_config": {
          "effort": "low"
        },
        "cache_control": {
          "type": "ephemeral"
        }
      }
    }
  },
  "agents": {
    "*": {
      "driver": "builtin"
    },
    "spec-writer": {
      "model": "opus"
    },
    "builder": {
      "model": "opus"
    },
    "approver": {
      "model": "opus"
    },
    "reviewer-security": {
      "model": "opus"
    },
    "reviewer-ux": {
      "model": "sonnet"
    },
    "reviewer-ui": {
      "model": "sonnet"
    },
    "reviewer-code": {
      "model": "sonnet"
    },
    "lead": {
      "model": "opus"
    },
    "coder": {
      "model": "opus"
    },
    "repo-scout": {
      "model": "sonnet"
    }
  }
}
