  "agents": {
    "*": {
      "driver": "builtin"
    },
    "spec-writer": {
      "model": "claude-opus",
      "reason": {
        "kind": "capability",
        "text": "the spec sets the bar for every later stage: Opus 5.5 high, #1 on intelligence"
      }
    },
    "builder": {
      "model": "muse-spark",
      "escalate": [
        "gpt-sol-high",
        "gpt-sol-xhigh"
      ],
      "reason": {
        "kind": "cost",
        "text": "the most tokens: Muse Spark 1.3 codes well (75.8) for $1.25/$4.25; CHANGES escalates to GPT-6.1 Sol high, then xhigh, instead of retrying"
      }
    },
    "coder": {
      "model": "muse-spark",
      "reason": {
        "kind": "cost",
        "text": "interactive coding on the value coder"
      }
    },
    "repo-scout": {
      "model": "mimo",
      "reason": {
        "kind": "cost",
