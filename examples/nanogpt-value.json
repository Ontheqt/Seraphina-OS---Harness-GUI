      "provider": "nanogpt-anthropic",
      "model": "claude-opus-5-5",
      "max_tokens": 64000,
      "context_tokens": 1000000,
      "stream": true,
      "allow_history_edits": false,
      "eager_tools": true,
      "extra_body": {
        "thinking": {
          "type": "adaptive",
          "display": "summarized"
        },
        "output_config": {
          "effort": "high"
        },
        "cache_control": {
