      }
    },
    "reviewer-code": {
      "model": "gpt-sol-high",
      "reason": {
        "kind": "stage-fit",
        "text": "OpenAI family, independent of the Meta builder; GPT-6.1 Sol at high reasoning (MiMo V2.6 Pro, Xiaomi, takes over when the builder escalates to GPT: a family no other lens uses)"
      },
      "independent_alternate": "mimo"
    },
    "reviewer-ux": {
      "model": "claude-sonnet",
      "reason": {
        "kind": "stage-fit",
        "text": "Anthropic family: Claude Sonnet 5.5 is a fast, careful UX reviewer"
