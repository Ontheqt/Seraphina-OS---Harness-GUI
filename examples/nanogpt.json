{
  "description": "Claude through NanoGPT's OpenAI-format API: one NANOGPT_API_KEY for many vendors. The model ids are the ones NanoGPT's public model list gives (anthropic/claude-opus-5.5 and so on, read on 2026-10-25); which of them your key may use is unchecked: factory doctor reads your key's list and warns for an id it does not list.",
  "providers": {
    "nanogpt": {
      "type": "openai",
      "base_url": "https://nano-gpt.com/api/v1",
      "api_key_env": "NANOGPT_API_KEY",
      "timeout": 900
    }
  },
  "models": {
    "opus": {
      "provider": "nanogpt",
      "model": "anthropic/claude-opus-5.5",
      "max_tokens": 32768,
      "stream": true,
      "extra_body": {}
    },
    "sonnet": {
      "provider": "nanogpt",
      "model": "anthropic/claude-sonnet-5.5",
      "max_tokens": 32768,
      "stream": true,
      "extra_body": {}
    },
    "haiku": {
      "provider": "nanogpt",
      "model": "anthropic/claude-haiku-5.5",
      "max_tokens": 16384,
      "stream": true,
      "extra_body": {}
    }
  },
  "agents": {
    "*": {
      "driver": "builtin"
    },
    "spec-writer": {
      "model": "opus"
    },
    "builder": {
      "model": "opus"
    },
    "approver": {
      "model": "opus"
    },
    "reviewer-security": {
      "model": "opus"
    },
    "reviewer-ux": {
      "model": "sonnet"
    },
    "reviewer-ui": {
      "model": "sonnet"
    },
    "reviewer-code": {
      "model": "sonnet"
    },
    "lead": {
      "model": "opus"
    },
    "coder": {
      "model": "opus"
    },
    "repo-scout": {
      "model": "sonnet"
    }
  }
}
