DISK_DEVICE_RE = re.compile(r"^/dev/(sd[a-z]+\d*|nvme\d+n\d+(p\d+)?|vd[a-z]+\d*|hd[a-z]+\d*|mem|kmem|port|dm-\d+|md\d+)$")
CANNOT_CHECK = [
    "Polkit rules are small programs that can depend on what happens when they run: they are listed, not decided.",
    "Sudo rules can also come from a directory service (SSSD or LDAP, named in /etc/nsswitch.conf) or from sudo-rs's "
    "@socket, which no file shows.",
    "PAM modules decide outside these files.",
