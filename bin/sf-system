    "Who may reach what on your Tailscale network, and any Tailscale SSH rules, live in Tailscale's admin console, not "
    "on the server.",
    "Your login gateway keeps its users and their second factors in its own database, which Seraphina never reads.",
    "A bug that lets a program escape a container or the kernel's own checks.",
]
CANNOT_SUDO_RS = ("Under sudo-rs, which has no cvtsudoers, only the accounts this server lists can be tested: a rule "
                  "for a name it does not list (a directory account, a user not made yet) is not seen.")
CANNOT_TWO_SUDOS = ("With two sudo programs installed, a rule they read differently is shown when one allows and the "
                    "other refuses; a difference no test reaches cannot be seen.")


class AccessScan:
    """The who-can-act-as-root enumeration: read-only, run as root in its job. Each row says why it counts: a "way"
    gives full control now (uid 0, a usable root password, full sudo, a root-equivalent group, a holder of Docker's
    socket, a container that reaches the host, a file a root service, cron job or setuid bit runs that someone else
    can change); "escape" rows could matter only if something escapes a container, and are never counted. A row is
    identified by its kind, its subject and its target (an account, a unit, a path, a Compose service, never a
    container id), so a recreated container keeps its row."""

    def __init__(self, helper: "Helper") -> None:
        self.h = helper
        self.paths = helper.paths
        self.accounts = helper.accounts
        self.rows: dict[str, dict] = {}
        self.unchecked: list[str] = []
        self.sudo: dict = {}
        self.full_sudo: dict[str, bool] = {}   # account -> full sudo without a password

    def row(self, kind: str, subject: str, target: str, group: str, words: str, why: str = "", *, way: bool = True,
            escape: bool = False, since: str | None = None) -> None:
        rid = hashlib.sha256(f"{kind}\0{subject}\0{target}".encode("utf-8", "replace")).hexdigest()[:16]
        if rid not in self.rows:
            self.rows[rid] = {"id": rid, "kind": kind, "subject": subject[:200], "target": target[:300],
                              "group": group, "way": way and not escape, "escape": escape, "words": words[:600],
                              "why": why[:1200], "since": since}

    def run(self) -> dict:
        for name, step in (("accounts", self.uid_zero), ("the root password", self.root_password),
                           ("sudo", self.sudo_rules), ("groups", self.groups), ("polkit", self.polkit),
                           ("ssh", self.ssh), ("docker", self.docker), ("containers", self.containers),
                           ("root services", self.services), ("cron", self.cron), ("setuid files", self.setuid),
                           ("file capabilities", self.capabilities), ("tools", self.tools), ("gateway", self.gateway)):
            try:
                step()
            except Refused as exc:
                self.unchecked.append(f"{name}: {exc.words}")
            except Exception as exc:  # noqa: BLE001 - one part that fails is said, never a failed page
                self.unchecked.append(f"{name}: could not be read ({type(exc).__name__})")
        cannot = list(CANNOT_CHECK)
        if self.sudo.get("implementation") == "sudo-rs":
            cannot.insert(2, CANNOT_SUDO_RS)
        if len(self.sudo.get("programs") or []) > 1:
            cannot.insert(2, CANNOT_TWO_SUDOS)
        rows = sorted(self.rows.values(), key=lambda r: (not r["way"], r["group"], r["subject"]))
        return {"schema": "seraphina-system-access/1", "at": now_iso(self.h.clock()), "rows": rows,
                "counts": {"ways": sum(1 for r in rows if r["way"]), "escape": sum(1 for r in rows if r["escape"]),
                           "rows": len(rows)},
                "sudo": self.sudo, "cannot_check": cannot, "unchecked": self.unchecked}

    # -- helpers ---------------------------------------------------------------------------------------------

    def run_tool(self, name: str, args: list[str], timeout: float = 60) -> tuple[int | None, str]:
        tool = self.h.tool(name)
        if tool is None:
            raise Refused("no_tool", f"{name} is not installed")
        code, out, _ = self.h.system.run([tool, *args], timeout)
        return code, out

    def name_of(self, uid: int) -> str:
        account = self.accounts.by_uid(uid)
        return account["name"] if account else f"the user number {uid}"

    def group_of(self, gid: int) -> str:
        return next((g["name"] for g in self.accounts.groups() if g["gid"] == gid), f"number {gid}")

    def changers(self, path: str) -> list[str]:
        """Who besides root can change path, or a folder above it (and so replace it): every component walked from /,
        without following the last link."""
        out: list[str] = []
        parts = _components(path)
        for index in range(len(parts) + 1):
            current = "/" + "/".join(parts[:index])
            try:
                info = self.h.lstat(self.paths.at(current) if current != "/" else self.paths.root)
            except OSError:
                continue
            sticky = stat.S_ISDIR(info.st_mode) and info.st_mode & stat.S_ISVTX
            if info.st_uid != 0:
                out.append(f"the account {self.name_of(info.st_uid)}")
            elif info.st_mode & 0o020 and not sticky and not stat.S_ISLNK(info.st_mode):
                out.append(f"anyone in the group {self.group_of(getattr(info, 'st_gid', 0))}")
            elif info.st_mode & 0o002 and not sticky and not stat.S_ISLNK(info.st_mode):
                out.append("anyone")
        return list(dict.fromkeys(out))

    def text(self, path: str, limit: int = 1 << 20) -> str | None:
        data = nofollow_read(self.paths.at(path), limit)
        return data.decode("utf-8", "replace") if data is not None else None

    def listing(self, folder: str) -> list[str]:
        return nofollow_list(self.paths.at(folder)) or []

    @staticmethod
    def ident(c: dict) -> str:
        labels = c.get("labels") or {}
        if labels.get("com.docker.compose.project") and labels.get("com.docker.compose.service"):
            return f"{labels['com.docker.compose.project']}/{labels['com.docker.compose.service']}"
        return re.sub(r"[-_]\d+$", "", str(c.get("name") or "")) or image_repository(c.get("image", ""))

    # -- the rows ------------------------------------------------------------------------------------------------

    def uid_zero(self) -> None:
        for account in self.accounts.passwd():
            if account["uid"] == 0 and account["name"] != "root":
                self.row("uid0", account["name"], "", "people", f"{account['name']}: has the administrator's number "
                         f"(uid 0), so it is the administrator.", "/etc/passwd: uid 0")

    def root_password(self) -> None:
        code, out = self.run_tool("passwd", ["-S", "root"], 30)
        fields = out.split()
        status = fields[1] if len(fields) > 1 else None
        if status == "P":
            self.row("root_password", "root", "set", "doors", "The root password is set: whoever knows it can take "
                     "full control at the console, and wherever root may sign in.", "passwd -S root: P (usable)")
        elif status == "NP":
            self.row("root_password", "root", "none", "doors", "The root account has no password at all.",
                     "passwd -S root: NP")

    def sudo_rules(self) -> None:
        implementation = sudo_implementation(self.paths)
        _, version = self.run_tool_path(self.paths.sudo, ["--version"])
        if version.strip().lower().startswith("sudo-rs"):
            implementation = "sudo-rs"
        programs = [{"name": "sudo", "path": self.paths.sudo, "implementation": implementation}]
        seen = {os.path.realpath(self.paths.sudo)}
        for name, kind in (("sudo.ws", "sudo"), ("sudo-rs", "sudo-rs")):
            path = self.paths.tool(name)
            if os.path.lexists(path) and os.path.realpath(path) not in seen and not path_problems(path, self.h.lstat):
                seen.add(os.path.realpath(path))
                programs.append({"name": name, "path": path, "implementation": kind})
        self.sudo = {"implementation": implementation, "programs": [{k: (self.paths.real(v) if k == "path" else v)
                                                                     for k, v in p.items()} for p in programs]}
        if len(programs) > 1:
            kinds = {"sudo": "classic sudo", "sudo-rs": "sudo-rs"}
            self.row("sudo_programs", "sudo", "+".join(p["name"] for p in programs), "doors",
                     f"Two sudo programs are installed ({kinds[programs[0]['implementation']]} as sudo, and "
                     f"{kinds[programs[1]['implementation']]} as {programs[1]['name']}). A rule that one ignores, the "
                     "other may honour.", "both are setuid root and read /etc/sudoers", way=False)
        names = {a["name"] for a in self.accounts.passwd()}
        for account in self.accounts.passwd():
            user = account["name"]
            if not USER_RE.fullmatch(user):
                continue
            answers = {}
            for program in programs:
                _, out = self.run_tool_path(program["path"], ["-l", "-U", user])
                answers[program["name"]] = parse_sudo_list(out)
            files: list[str] = []
            if any(a["allowed"] for a in answers.values()):
                _, out = self.run_tool_path(self.paths.sudo, ["-ll", "-U", user])
                files = parse_sudo_files(out)
            full = [r for a in answers.values() for r in a["rules"] if r["full"]]
            nopass = any(r["nopasswd"] for r in full)
            where = f"a sudo rule in {', '.join(files)}" if files else "a sudo rule"
            exact = "; ".join(f"{p}: " + ("; ".join(f"({r['runas']}) {'NOPASSWD: ' if r['nopasswd'] else ''}"
                                                     f"{', '.join(r['commands'])}" for r in a["rules"]) or "not allowed")
                              for p, a in answers.items())
            if full:
                self.full_sudo[user] = nopass
                escape = sorted({e for r in full for e in r["escape"] if e != "ALL"})
                only = [p for p, a in answers.items() if any(r["full"] for r in a["rules"])]
                self.row("sudo", user, "full", "people", f"{user}: can act as root " +
                         ("without any password" if nopass else "with its own password") + f" ({where}" +
                         (f"; {escape[0]} can start other programs" if escape else "") + ")." +
                         (f" Only {', '.join(only)} allows it." if len(only) < len(answers) else ""), exact)
            elif any(a["allowed"] for a in answers.values()):
                commands = sorted({c for a in answers.values() for r in a["rules"] for c in r["commands"]})
                self.row("sudo", user, "commands", "people", f"{user}: can run these commands as root: "
                         f"{', '.join(commands)[:300]}. Seraphina can't tell whether they can start others.", exact,
                         way=False)
            verdicts = {p: (a["allowed"], any(r["full"] for r in a["rules"])) for p, a in answers.items()}
            if len(set(verdicts.values())) > 1:
                said = "; ".join(f"{p} {'allows full control' if v[1] else 'allows some commands' if v[0] else 'refuses'}"
                                 for p, v in verdicts.items())
                self.row("sudo_disagree", user, "", "doors", f"The two sudo programs disagree about {user}: {said}.",
                         exact, way=any(v[1] for v in verdicts.values()))
        cvt = self.h.tool("cvtsudoers")
        if cvt is not None:
            code, out, _ = self.h.system.run([cvt, "-f", "json", self.paths.real(self.paths.at("/etc/sudoers"))], 60)
            doc = self.h._json_bytes(out.encode()) if code == 0 else None
            for spec in (doc or {}).get("User_Specs") or [] if isinstance(doc, dict) else []:
                for who in (spec or {}).get("User_List") or [] if isinstance(spec, dict) else []:
                    if not isinstance(who, dict):
                        continue
                    if "username" in who and str(who["username"]) not in names and who["username"] != "ALL":
                        self.row("sudo_unknown", str(who["username"]), "", "people", f"A sudo rule names "
                                 f"{who['username']}, which is not an account on this server now.",
                                 "cvtsudoers -f json /etc/sudoers", way=False)
                    if "usergroup" in who:
                        group = str(who["usergroup"]).lstrip("%")
                        if not any(g["name"] == group for g in self.accounts.groups()):
                            self.row("sudo_unknown", "%" + group, "", "people", f"A sudo rule names the group {group}, "
                                     "which is not a group on this server now.", "cvtsudoers -f json", way=False)
        visudo = self.h.tool("visudo-rs" if implementation == "sudo-rs" else "visudo") or self.h.tool("visudo")
        if visudo is not None:
            code, _, _ = self.h.system.run([visudo, "-c"], 30)
            if code not in (0, None):
                self.row("sudoers_error", "sudoers", "", "doors", "The sudo settings have an error, so sudo may read "
                         "less than they say.", "visudo -c failed", way=False)
        for name in self.listing("/etc/sudoers.d"):
            if not sudoers_d_read(name):
                self.row("sudoers_file", f"/etc/sudoers.d/{name}", "not_read", "files", f"/etc/sudoers.d/{name} is not "
                         "read by sudo (its name has a dot or ends in ~), whatever it says.", "@includedir skips such "
                         "names", way=False)
        nss = self.text("/etc/nsswitch.conf") or ""
        sources = next((line.split(":", 1)[1].split() for line in nss.split("\n") if line.startswith("sudoers:")), [])
        if any(s in ("sss", "ldap") for s in sources):
            self.row("sudo_directory", "nsswitch", "sudoers", "doors", "Sudo rules also come from a directory service "
                     f"({', '.join(sources)}), which Seraphina can't read.", "/etc/nsswitch.conf", way=False)

    def run_tool_path(self, path: str, args: list[str]) -> tuple[int | None, str]:
        if not os.path.lexists(path) or path_problems(path, self.h.lstat):
            return None, ""
        code, out, _ = self.h.system.run([path, *args], 60)
        return code, out

    def groups(self) -> None:
        for name in ("sudo", "admin", "wheel", "docker", "lxd", "incus-admin", "libvirt", "disk", "shadow"):
            group = next((g for g in self.accounts.groups() if g["name"] == name), None)
            if group is None:
                continue
            members = set(group["members"]) | {a["name"] for a in self.accounts.passwd() if a["gid"] == group["gid"]}
            for member in sorted(members - {"root"}):
                self.row("group", member, name, "people" if name != "shadow" else "escape",
                         f"{member}: in the {name} group, {GROUP_WORDS[name]}.", f"/etc/group: {name}",
                         way=name != "shadow", escape=name == "shadow")

    def polkit(self) -> None:
        for folder in ("/etc/polkit-1/rules.d", "/usr/share/polkit-1/rules.d"):
            for name in self.listing(folder):
                if not name.endswith(".rules"):
                    continue
                if name == "49-ubuntu-admin.rules":
                    self.row("polkit", name, "admin", "doors", "Members of the sudo and admin groups are administrators "
                             "for polkit, so they can approve system changes, Cockpit's included.", f"{folder}/{name}",
                             way=False)
                else:
                    self.row("polkit_rules", f"{folder}/{name}", "", "doors", f"{folder}/{name}: a polkit rule file. "
                             "Its rules are a small program: listed, not decided.", f"{folder}/{name}", way=False)

    def ssh(self) -> None:
        settings: dict = {}
        sshd = self.h.tool("sshd")
        if sshd is not None:
            code, out, _ = self.h.system.run([sshd, "-T"], 30)
            settings = parse_sshd(out) if code == 0 else {}
        if not settings:
            self.unchecked.append("ssh: the SSH server's settings could not be read (sshd -T)")
        if settings.get("passwordauthentication") == "yes":
            self.row("ssh_setting", "sshd", "password", "doors", "Password sign-in over SSH is on.",
                     "sshd -T: passwordauthentication yes", way=False)
        root_login = settings.get("permitrootlogin", "prohibit-password")
        if root_login not in ("no",):
            self.row("ssh_setting", "sshd", "root_login", "doors", f"The root account may sign in over SSH "
                     f"({'with its password or a key' if root_login == 'yes' else 'with a key'}).",
                     f"sshd -T: permitrootlogin {root_login}", way=False)
        command = settings.get("authorizedkeyscommand", "none")
        if command and command != "none":
            self.row("ssh_keys_command", "sshd", "command", "doors", "SSH keys also come from a program "
                     "(AuthorizedKeysCommand): Seraphina can't list them.", "sshd -T: authorizedkeyscommand", way=False)
        if settings.get("trustedusercakeys", "none") not in ("none", ""):
            self.row("ssh_ca", "sshd", "ca", "doors", "SSH keys signed by a certificate authority are accepted "
                     "(TrustedUserCAKeys): anyone holding that authority's key can make new ones.",
                     "sshd -T: trustedusercakeys", way=False)
        patterns = (settings.get("authorizedkeysfile") or ".ssh/authorized_keys .ssh/authorized_keys2").split()
        for account in self.accounts.passwd():
            home = account["home"]
            if not home.startswith("/") or home in ("/", "/nonexistent") or not os.path.isdir(self.paths.at(home)):
                continue
            for pattern in patterns:
                path = pattern.replace("%%", "\0").replace("%h", home).replace("%u", account["name"]).replace("\0", "%")
                path = path if path.startswith("/") else f"{home.rstrip('/')}/{path}"
                text = self.text(path)
                if text is None:
                    continue
                for key in parse_authorized_keys(text):
                    if key.get("garbage"):
                        self.row("ssh_garbage", path, str(key["line"]), "files", f"{path} has a line that is not a "
                                 f"key (line {key['line']}).", "parsed by Seraphina", way=False)
                        continue
                    user = account["name"]
                    limited = [o for o in key["options"] if o.split("=")[0] in ("restrict", "command", "from")]
                    root = account["uid"] == 0 and root_login != "no"
                    way = root or self.full_sudo.get(user) is True
                    note = (" It signs in as root." if root else " Its account can act as root without a password."
                            if self.full_sudo.get(user) else " Its account can act as root with its password."
                            if user in self.full_sudo else "")
                    self.row("ssh_key", user, key["fingerprint"], "people",
                             f"{user}: an SSH key ({key['comment'] or key['type']}) " +
                             ("with no limits." if not limited else "limited: " + ", ".join(limited) + ".") + note,
                             f"{path} line {key['line']}: {key['type']} {key['fingerprint']}" +
                             (f" options {', '.join(key['options'])}" if key["options"] else ""), way=way)

    def docker(self) -> None:
        sock = self.paths.at("/run/docker.sock")
        try:
            info = self.h.lstat(sock)
        except OSError:
            return
        if info.st_uid != 0 or info.st_mode & 0o002:
            self.row("docker_socket_mode", "/run/docker.sock", "mode", "files", "Docker's socket can be used by "
                     + ("anyone" if info.st_mode & 0o002 else f"the account {self.name_of(info.st_uid)}") +
                     ", which can then control the whole server.", f"owner {info.st_uid}, mode {oct(info.st_mode)}")
        try:
            code, out = self.run_tool("ss", ["-Hxp"], 30)
        except Refused:
            return
        for line in out.split("\n"):
            if "docker.sock" not in line:
                continue
            for name, _pid in SS_USERS_RE.findall(line):
                if name not in ("dockerd", "containerd", "systemd", "docker-proxy", "init"):
                    self.row("docker_client", name[:64], "", "programs", f"The program {name[:64]} is connected to "
                             "Docker's socket now, so it can control the whole server.", "ss -Hxp", way=True)

    def containers(self) -> None:
        stacks = (self.h._read_json(self.paths.helper_config) or {}).get("stacks_dir") or DOCKGE_STACKS
        root = self.paths.real(self.h.data_root())
        for c in self.h.containers():
            if c.get("error"):
                continue
            ident, name = self.ident(c), c.get("name") or "a container"
            repo = image_repository(c.get("image", ""))
            sources = [(m.get("source") or "", m.get("rw")) for m in c.get("mounts") or []]
            if repo in ("louislam/dockge", "docker.io/louislam/dockge"):
                exposed = c.get("network_mode") == "host" or any(p.get("host_ip") not in ("127.0.0.1", "::1")
                                                                 for p in c.get("ports") or [])
                self.row("dockge", ident, "", "programs", "Dockge: can control Docker, which can control the whole "
                         "server. Anyone who can sign in to Dockge can too" +
                         (", and Dockge can be reached from your home network." if exposed else "."),
                         "it mounts Docker's socket")
                if str((c.get("env") or {}).get("DOCKGE_ENABLE_CONSOLE") or "").lower() in ("true", "1", "yes"):
                    self.row("dockge_console", ident, "", "programs", "Dockge's console is on: anyone signed in to "
                             "Dockge gets a command line beside its control of Docker.", "DOCKGE_ENABLE_CONSOLE")
                stacks = (c.get("env") or {}).get("DOCKGE_STACKS_DIR") or stacks
            elif c.get("docker_socket"):
                ro = not any(rw for s, rw in sources if s in ("/run/docker.sock", "/var/run/docker.sock"))
                self.row("docker_socket", ident, "", "programs", f"{name}: can control Docker" +
                         (" (its socket is mounted read-only, which does not limit what it can ask)" if ro else "") +
                         ", and so the whole server.", "it mounts Docker's socket")
            full, could = [], []
            if c.get("privileged"):
                full.append("runs privileged, with every device and power of the server")
            caps = [cap.upper() for cap in c.get("cap_add") or []]
            if any(cap in FULL_CAPS for cap in caps) or (any("SYS_PTRACE" in cap for cap in caps) and
                                                         c.get("pid_mode") == "host"):
                full.append("has powers that reach the server itself (" + ", ".join(caps[:4]) + ")")
            elif caps:
                could.append("has extra powers (" + ", ".join(caps[:4]) + ")")
            binds = [s for s, _ in sources if s.rstrip("/") in HOST_BINDS or s == "/" or s.rstrip("/") == root]
            binds = [b for b in binds if b not in ("/run/docker.sock", "/var/run/docker.sock")]
            if binds:
                full.append("mounts " + ", ".join(sorted(set(binds))[:3]) + " from the server")
            root_inside = c.get("user") in ("", "0", "root")
            if root_inside and any(s in DBUS for s, _ in sources):
                full.append("runs as root and reaches the server's system bus, which can drive systemd")
            devices = c.get("device_paths") or []
            if any(DISK_DEVICE_RE.match(d) for d in devices) or any(s == "/dev" for s, _ in sources):
                full.append("uses a disk of the server directly")
            elif devices:
                could.append("uses " + plural_words(len(devices), "device") + " of the server")
            data = sorted({s for s, rw in sources if rw and s.startswith(("/mnt/", "/srv/", "/media/"))})
            if data:
                could.append("can write " + ", ".join(data[:3]))
            if root_inside:
                could.append("runs as root inside its container")
            if any(o.split("=", 1)[-1].split(":")[-1] in ("unconfined", "disable") for o in c.get("security_opt") or []):
                could.append("has its confinement turned off")
            for mode, words in (("network_mode", "the server's network"), ("pid_mode", "the server's programs"),
                                ("ipc_mode", "the server's shared memory")):
                if c.get(mode) == "host":
                    could.append(f"shares {words}")
            if full:
                self.row("container", ident, "full", "programs", f"{name}: " + "; ".join(full) + ".",
                         f"image {c.get('image', '')[:120]}")
            if could:
                self.row("container", ident, "escape", "escape", f"{name}: " + "; ".join(could) + ".",
                         f"image {c.get('image', '')[:120]}", way=False, escape=True)
        self.dockge_files(stacks)

    def dockge_files(self, stacks: str) -> None:
        if not _plain_path(stacks) or not os.path.isdir(self.paths.at(stacks)):
            return
        targets = [stacks]
        for name in self.listing(stacks)[:500]:
            folder = f"{stacks.rstrip('/')}/{name}"
            if not os.path.isdir(self.paths.at(folder)) or os.path.islink(self.paths.at(folder)):
                continue
            targets.append(folder)
            for leaf in ("compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml", "compose.json",
                         ".env"):
                if os.path.lexists(self.paths.at(f"{folder}/{leaf}")):
                    targets.append(f"{folder}/{leaf}")
        for path in targets:
            who = self.changers(path)
            if who:
                self.row("dockge_write", path, who[0], "files", f"Anyone who can change {path} ({', '.join(who)}) can "
                         "run anything as root through Dockge.", "Dockge deploys what its stacks say, as root")

    def services(self) -> None:
        code, out = self.run_tool("systemctl", ["list-units", "--type=service", "--all", "--output=json", "--no-pager"])
        try:
            units = [u.get("unit") for u in json.loads(out or "[]") if isinstance(u, dict)]
        except ValueError:
            units = []
        units = [u for u in units if isinstance(u, str) and UNIT_RE.fullmatch(u)]
        props = "Id,User,ExecStart,ExecStartPre,ExecStartPost,WorkingDirectory,EnvironmentFiles,FragmentPath,DropInPaths"
        for index in range(0, len(units), 40):
            _, shown = self.run_tool("systemctl", ["show", "-p", props, "--", *units[index:index + 40]])
            for block in parse_systemctl_show(shown):
                unit = block.get("Id") or ""
                if block.get("User") not in ("", "root", None) or not UNIT_RE.fullmatch(unit):
                    continue
                workdir = (block.get("WorkingDirectory") or "").lstrip("!-") or None
                paths: list[tuple[str, str | None, str]] = []   # (path, note, runs|uses)
                for key in ("ExecStart", "ExecStartPre", "ExecStartPost"):
                    for argv in exec_argvs(block.get(key) or ""):
                        found, note = exec_paths(argv, workdir)
                        paths += [(p, note if i else None, "runs") for i, p in enumerate(found)]
                for key in ("WorkingDirectory", "FragmentPath"):
                    if (block.get(key) or "").lstrip("!-").startswith("/"):
                        paths.append((block[key].lstrip("!-"), None, "uses"))
                for value in (block.get("EnvironmentFiles") or "").split() + (block.get("DropInPaths") or "").split():
                    if value.startswith("/"):
                        paths.append((value, None, "uses"))
                since = None
                with contextlib.suppress(OSError):
                    since = now_iso(os.lstat(self.paths.at(block.get("FragmentPath") or "/nonexistent")).st_mtime)
                for path, note, how in dict.fromkeys(paths):
                    if how == "runs" and path.startswith("/home/"):
                        owner = path.split("/")[2]
                        self.row("root_service_home", unit, path, "files", f"The root service {unit} runs a script "
                                 f"from {owner}'s home folder ({path}).", f"{note or 'its program'}; its unit file is "
                                 f"from {since or 'an unknown time'}", since=since)
                    who = self.changers(path)
                    if who:
                        self.row("root_service", unit, path, "files", f"The root service {unit} {how} {path}, which "
                                 f"{who[0]} can change.", f"{', '.join(who)} can change {path} or a folder above it" +
                                 (f"; {note}" if note else ""), since=since)

    def cron(self) -> None:
        sources: list[tuple[str, bool]] = [("/etc/crontab", True), ("/etc/anacrontab", False)]
        sources += [(f"/etc/cron.d/{n}", True) for n in self.listing("/etc/cron.d") if not n.startswith(".")]
        sources += [("/var/spool/cron/crontabs/root", False)]
        for path, with_user in sources:
            text = self.text(path)
            if text is None:
                continue
            who = self.changers(path)
            if who:
                self.row("cron_file", path, "", "files", f"{path} runs jobs as root, and {who[0]} can change it.",
                         ", ".join(who))
            if path == "/etc/anacrontab":
                commands = [" ".join(line.split()[3:]) for line in text.split("\n") if line.strip() and
                            not line.strip().startswith("#") and not re.match(r"^\s*[A-Za-z_]+=", line)
                            and len(line.split()) > 3]
            else:
                commands = []
                for line in text.split("\n"):
                    fields = line.split()
                    skip = (1 if line.strip().startswith("@") else 5)
                    if with_user and len(fields) > skip and fields[skip] != "root":
                        continue
                    commands += cron_commands(line, with_user)
            for command in commands:
                found, _ = exec_paths(command.split())
                for target in found:
                    changed = self.changers(target)
                    if changed:
                        self.row("cron", path, target, "files", f"A scheduled job in {path} runs {target}, which "
                                 f"{changed[0]} can change.", ", ".join(changed))
        for period in ("hourly", "daily", "weekly", "monthly"):
            for name in self.listing(f"/etc/cron.{period}"):
                target = f"/etc/cron.{period}/{name}"
                changed = self.changers(target)
                if changed:
                    self.row("cron", f"/etc/cron.{period}", target, "files", f"The {period} job {target} runs as "
                             f"root, and {changed[0]} can change it.", ", ".join(changed))

    def packaged(self, path: str) -> str | None:
        """The package that installed path (dpkg -S on it and on its /usr or legacy alias), or None."""
        aliases = [path]
        for old, new in (("/bin/", "/usr/bin/"), ("/sbin/", "/usr/sbin/"), ("/lib/", "/usr/lib/")):
            if path.startswith(new):
                aliases.append(old + path[len(new):])
            elif path.startswith(old):
                aliases.append(new + path[len(old):])
        for candidate in aliases:
            code, out = self.run_tool("dpkg", ["-S", candidate], 30)
            if code == 0 and ":" in out:
                return out.split(":", 1)[0].split(",")[0].strip()[:120]
        return None

    def setuid(self) -> None:
        found: list[str] = []
        for _, mount, _ in self.h.real_mounts():
            target = self.paths.at(mount) if mount != "/" else self.paths.root
            code, out = self.run_tool("find", [target, "-xdev", "(", "-perm", "-4000", "-o", "-perm", "-2000", ")",
                                               "-type", "f", "-print"], 600)
            found += [self.paths.real(line) for line in out.split("\n") if line.startswith("/")]
        checked: dict[str, set[str]] = {}
        for path in sorted(set(found))[:500]:
            package = self.packaged(path)
            if package is None:
                self.row("setuid", path, "unpackaged", "files", f"{path} runs as its owner (setuid) and no package "
                         "installed it.", "dpkg -S found no package")
                continue
            if package not in checked:
                _, out = self.run_tool("dpkg", ["-V", package], 120)
                checked[package] = {line.split()[-1] for line in out.split("\n") if len(line) > 3 and line[2] == "5"}
            if path in checked[package]:
                self.row("setuid", path, "changed", "files", f"{path} runs as its owner (setuid) and has changed since "
                         f"its package ({package}) installed it.", f"dpkg -V {package}: checksum differs")
        self.sudo["setuid_files"] = len(set(found))

    def capabilities(self) -> None:
        code, out = self.run_tool("getcap", ["-r", self.paths.root], 300)
        for line in out.split("\n"):
            match = re.match(r"^(/\S+)\s+=?\s*(\S+)$", line.strip())
            if not match:
                continue
            path, caps = self.paths.real(match.group(1)), match.group(2).lower()
            danger = [c for c in DANGEROUS_CAPS if c in caps]
            if danger and self.packaged(path) is None:
                self.row("capability", path, ",".join(danger), "files", f"{path} has the power {danger[0]} and no "
                         "package installed it.", f"getcap: {caps[:120]}")

    def tools(self) -> None:
        cfg = self.h._read_json(self.paths.helper_config) or {}
        allow = [c for c in cfg.get("allow") or [] if c in CLASS_WORDS]
        self.row("tool", "seraphina", "", "programs", "Seraphina's system access: only these actions: " +
                 "; ".join(CLASS_WORDS[c] for c in allow) + ".", f"{self.paths.real(self.paths.helper)}, allowed by "
                 f"{self.paths.real(self.paths.sudoers)}", way=False)
        code, out = self.run_tool("systemctl", ["list-unit-files", "--no-legend", "--no-pager", "cockpit.socket"], 30)
        if "cockpit.socket" in out:
            self.row("tool", "cockpit", "", "doors", "Cockpit gives root to anyone who signs in and has sudo, or whom "
                     "polkit allows.", "cockpit.socket is installed", way=False)

    def gateway(self) -> None:
        try:
            answer = self.h.verb_ingress({}, None)
        except Refused:
            return
        for gateway in answer["gateways"]:
            routes = gateway.get("routes") or []
            if not routes or not any(r.get("auth") == "sign-in" for r in routes):
                continue
            ident = self.ident(next((c for c in self.h.containers() if c.get("id") == gateway["container"]), {}))
            self.row("gateway", ident, "", "programs", f"Your login gateway ({gateway['name']}): decides who can reach "
                     f"{plural_words(len(routes), 'route')}. Anyone who can change its files or its Dockge stack, or "
                     "sign in to its sign-in service as an administrator, can let anyone in.",
                     "its nginx routes ask for the sign-in", way=False)


def plural_words(count: int, word: str) -> str:
    return f"{count} {word if count == 1 else word + 's'}"


# ---------------------------------------------------------------- setup, remove and explain (section 6.11)


def sudo_implementation(paths: Paths) -> str:
    """sudo-rs or classic sudo, decided from where /usr/bin/sudo resolves (never from whether cvtsudoers exists):
    Ubuntu 25.10 and later ship sudo-rs as sudo (under /usr/lib/cargo/) and keep classic sudo as sudo.ws."""
    real = os.path.realpath(paths.sudo)
    return "sudo-rs" if "/cargo/" in real or os.path.basename(real).startswith("sudo-rs") else "sudo"


def sudoers_text(user: str, implementation: str) -> str:
    """The sudoers file `setup` writes from its own template, never from a staged file: Seraphina's user may run this
    helper with no arguments at all (the "" rule). The Defaults line is left out under sudo-rs until lab L7 shows
    that version accepts it; the harness never has a terminal, so no pty is used either way."""
    lines = ["# Seraphina OS Harness: Seraphina's system access, with no arguments; what it may do is in "
             "/etc/seraphina/system-helper.json (docs/seraphina/YOUR_SERVER.md §6.11)"]
    if implementation != "sudo-rs":
        lines.append(f"Defaults!{HELPER} !use_pty")
    lines.append(f"{user} ALL=(root) NOPASSWD: {HELPER} \"\"")
    return "\n".join(lines) + "\n"


def _allow_words(allow: list[str]) -> str:
    return "; ".join(CLASS_WORDS.get(item, item) for item in allow) or "nothing"


def _done_words(allow: list[str]) -> str:
    if set(allow) <= {"read"}:
        return OK_WORDS
    return f"Done. Seraphina may now {_allow_words(allow)}. Go back to Seraphina; the page updates by itself."


def _write_new(path: str, data: str, mode: int, system: System) -> None:
    """data to path (a .new beside its place), owned by root with mode; never through a link."""
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    with contextlib.suppress(FileNotFoundError):
        os.unlink(path)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(data)
    os.chmod(path, mode)
    system.chown_root(path)


def setup(staged: str, paths: Paths, system: System | None = None, lstat: Callable[[str], Any] = os.lstat,
          environ: dict | None = None, out: Callable[[str], None] = print) -> int:
    """`setup <staged config>`, through the owner's own sudo in a terminal (section 6.11): checks its own .new copy,
    reads and checks the staged config itself, writes the sudoers file from its own template and checks it with the
    sudo implementation's own visudo, says in its own words what will be allowed, asks for yes, and moves the helper,
    its config and the sudoers file into place in that order. On any refusal its .new files are removed and the
    installed ones are left as they were. 0 done, 2 refused."""
    system = system or System(paths)
    environ = os.environ if environ is None else environ
    news = [paths.helper + ".new", paths.helper_config + ".new", paths.sudoers + ".new"]

    def refuse(words: str) -> int:
        for path in news[1:] + news[:1]:
            with contextlib.suppress(OSError):
                os.unlink(path)
        out(f"Refused: {words}")
        out("Something did not match, so nothing was changed.")
        return 2

    if system.euid() != 0:
        return refuse("setup must run as root, through your own sudo.")
    if not system.tty():
        return refuse("setup needs a terminal: paste it into your own terminal.")
    accounts = Accounts(paths)
    sudo_uid = str(environ.get("SUDO_UID") or "")
    if not os.path.lexists(news[0]):
        return refuse(f"{paths.real(news[0])} is not there: the first part of the paste installs it.")
    problems = path_problems(news[0], lstat)
    if problems:
        return refuse(problems[0] + ".")
    data = nofollow_read(staged, MAX_REQUEST) if _plain_path(staged) else None
    if data is None:
        return refuse("the staged settings must be one regular file of at most 16 KiB, reached without a link.")
    try:
        cfg = json.loads(data.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return refuse("the staged settings are not JSON.")
    shape = check_config(cfg, accounts, paths)
    if shape:
        return refuse(shape[0] + ".")
    if sudo_uid in (cfg.get("callers") or {}):
        return refuse("setup must be run by you, not by Seraphina's own account.")
    callers = [accounts.by_uid(int(uid)) for uid in cfg["callers"]]
    if len(callers) != 1 or callers[0] is None or not USER_RE.fullmatch(callers[0]["name"]):
        return refuse("this version takes exactly one caller, Seraphina's own account.")
    user = callers[0]["name"]
    implementation = sudo_implementation(paths)
    visudo = paths.tool("visudo-rs" if implementation == "sudo-rs" else "visudo")
    if implementation == "sudo-rs" and not os.path.lexists(visudo):
        visudo = paths.tool("visudo")
    if not os.path.lexists(visudo) or path_problems(visudo, lstat):
        return refuse(f"visudo is not installed safely at {paths.real(visudo)}.")
    try:
        _write_new(news[2], sudoers_text(user, implementation), 0o440, system)
        _write_new(news[1], json.dumps(cfg, indent=1, sort_keys=True) + "\n", 0o644, system)
    except OSError as exc:
        return refuse(f"a file could not be written ({exc.strerror or type(exc).__name__}).")
    code, _, _ = system.run([visudo, "-cf", paths.real(news[2])], TIMEOUTS["short"])
    if code != 0:
        return refuse(f"sudo ({implementation}) would not accept the new sudoers file.")
    old = Helper(paths, system, lstat)._read_json(paths.helper_config) if os.path.isfile(paths.helper_config) else None
    old = old if isinstance(old, dict) else {}
    owners = [accounts.by_uid(uid) for uid in cfg.get("owners") or []]
    allow_line = _allow_words(cfg["allow"])
    if old.get("allow") is not None and old.get("allow") != cfg["allow"]:
        allow_line = f"{_allow_words(old['allow'])} → {allow_line}"
    out(f"Seraphina may: {allow_line}. " + ("She can change nothing on your server." if set(cfg["allow"]) <=
                                             {"read", "private"} else "Apart from that she changes nothing on your "
                                                                      "server."))
    out(f"Callers: the user {user} (uid {callers[0]['uid']}), with no password, through sudo ({implementation}).")
    out("Your accounts: " + (", ".join(o["name"] for o in owners if o) or "none named"))
    out(f"To switch it all off: sudo rm {paths.real(paths.sudoers)}")
    if system.ask("Type yes to install it: ").strip().lower() != "yes":
        return refuse("you did not type yes.")
    try:
        os.replace(news[0], paths.helper)
        os.replace(news[1], paths.helper_config)
        os.replace(news[2], paths.sudoers)
    except OSError as exc:
        return refuse(f"a file could not be moved into place ({exc.strerror or type(exc).__name__}).")
    out(_done_words(cfg["allow"]))
    return 0


def remove(paths: Paths, system: System | None = None, environ: dict | None = None,
           lstat: Callable[[str], Any] = os.lstat, out: Callable[[str], None] = print) -> int:
    """`remove`, through the owner's own sudo in a terminal: the sudoers file first (which alone ends all of the
    helper's root access), then its config and the helper itself; the state folder only after a second yes."""
    system = system or System(paths)
    environ = os.environ if environ is None else environ
    if system.euid() != 0 or not system.tty():
        out("Refused: remove must run in your own terminal, through your own sudo. Nothing was changed.")
        return 2
    cfg = Helper(paths, system, lstat, environ={})._read_json(paths.helper_config)
    if isinstance(cfg, dict) and str(environ.get("SUDO_UID") or "") in (cfg.get("callers") or {}):
        out("Refused: remove must be run by you, not by Seraphina's own account. Nothing was changed.")
        return 2
    out(f"This removes {paths.real(paths.sudoers)}, {paths.real(paths.helper_config)} and "
        f"{paths.real(paths.helper)}. Seraphina's system access then ends at once.")
    if system.ask("Type yes to remove it: ").strip().lower() != "yes":
        out("Nothing was changed.")
        return 2
    for path in (paths.sudoers, paths.helper_config, paths.helper):
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)
    if os.path.isdir(paths.state):
        out(f"{paths.real(paths.state)} holds what the helper kept (no secret in this version).")
        if system.ask("Type yes to remove that folder too, or press Enter to keep it: ").strip().lower() == "yes":
            for folder, dirs, files in os.walk(paths.state, topdown=False):
                for name in files:
                    with contextlib.suppress(OSError):
                        os.unlink(os.path.join(folder, name))
                for name in dirs:
                    with contextlib.suppress(OSError):
                        os.rmdir(os.path.join(folder, name))
            with contextlib.suppress(OSError):
                os.rmdir(paths.state)
    out("Done. Seraphina's system access is removed.")
    return 0


def explain(what: str, paths: Paths, system: System | None = None, lstat: Callable[[str], Any] = os.lstat,
            out: Callable[[str], None] = print) -> int:
    """`explain helper-config`: what the staged .new config allows and every change from the installed one;
    `explain ingress`: the login gateway's routes, in plain words, for the owner's own check (lab L16). Change
    nothing. 0 when fine, 2 when not."""
    system = system or System(paths)
    if what == "access":
        helper = Helper(paths, system, lstat, environ={})
        try:
            helper.installation()
        except Refused as exc:
            out(f"Refused ({exc.code}): {exc.words}")
            return 2
        result = AccessScan(helper).run()
        counts = result["counts"]
        out(f"Who can take full control of your server? Seraphina found {plural_words(counts['ways'], 'way')}. "
            "Some kinds can't be checked from here (listed at the end).")
        titles = {"people": "People", "programs": "Programs", "doors": "Doors", "files": "Files",
                  "escape": "Could matter if something escapes"}
        for group, title in titles.items():
            rows = [r for r in result["rows"] if r["group"] == group]
            if not rows:
                continue
            out("")
            out(title + ":")
            for row in rows:
                out(f"  {'*' if row['way'] else '-'} {row['words']}")
        out("")
        out("What Seraphina can't see from here:")
        for line in result["cannot_check"]:
            out(f"  - {line}")
        for line in result["unchecked"]:
            out(f"  - Not read this time: {line}")
        out("")
        out("* gives full control now. Nothing was changed.")
        return 0
    if what == "ingress":
        helper = Helper(paths, system, lstat, environ={})
        try:
            answer = helper.verb_ingress({}, None)
        except Refused as exc:
            out(f"Refused ({exc.code}): {exc.words}")
            return 2
        for gateway in answer["gateways"]:
            out(f"{gateway['name']}: " + (gateway.get("error") or f"{len(gateway.get('routes') or [])} routes"))
            for route in gateway.get("routes") or []:
                ups = ", ".join(f"{u['host']}:{u['port']}" for u in route["upstream"]) or "(not named)"
                listen = route["listen"]
                out(f"  {listen['address']}:{listen['port']}{' ssl' if listen['ssl'] else ''} "
                    f"{','.join(route['server_names']) or '-'} {route['path']} -> {ups} "
                    f"({'asks for the sign-in' if route['auth'] == 'sign-in' else 'no sign-in'})")
        return 0
    new = paths.helper_config + ".new"
    problems = path_problems(new, lstat)
    if problems:
        out(f"Refused: {problems[0]}. Install it with sudo install -o root -g root -m 0644 first.")
        return 2
    helper = Helper(paths, system, lstat, environ={})
    cfg = helper._read_json(new)
    shape = check_config(cfg, Accounts(paths), paths)
    if shape:
        out("Refused: the helper's new settings cannot be used:")
        for line in shape:
            out(f"  - {line}")
        return 2
    old = helper._read_json(paths.helper_config) if os.path.isfile(paths.helper_config) else None
    old = old if isinstance(old, dict) else {}
    out(f"The helper's new settings ({paths.real(new)}):")
    for key, words in (("allow", "Allowed"), ("callers", "Callers"), ("owners", "Your accounts"),
                       ("stacks_dir", "Dockge's stacks folder"), ("keep", "Kept versions")):
        value, before = cfg.get(key), old.get(key)
        shown = _allow_words(value) if key == "allow" else json.dumps(value, sort_keys=True)
        if old and before != value:
            was = _allow_words(before) if key == "allow" and before else json.dumps(before, sort_keys=True)
            out(f"  {words}: {was} → {shown}")
        else:
            out(f"  {words}: {shown}")
    out("It changes nothing until you move it into place. It holds no secret.")
    return 0


# ---------------------------------------------------------------- main


SYSTEMD_RUN = "/usr/bin/systemd-run"
# Each verb in a transient unit started by PID 1, in the host's mount namespace (section 6.1): a harness unit hardened
# with ProtectSystem=strict or TemporaryFileSystem= would otherwise hide what the helper reads. UNVERIFIED on a
# systemd-booted machine (lab L8).
PID1_ARGV = (SYSTEMD_RUN, "--wait", "--pipe", "--collect", "--quiet", "--property=NoNewPrivileges=yes",
             "--property=PrivateTmp=yes", "--property=ProtectHome=read-only")


def wants_pid1(paths: Paths, lstat: Callable[[str], Any]) -> bool:
    if path_problems(paths.helper_config, lstat):
        return False
    cfg = Helper(paths, None, lstat, environ={})._read_json(paths.helper_config)
    return isinstance(cfg, dict) and cfg.get("pid1") is True and not check_config(cfg)


def run_job(job: str, paths: Paths, system: System | None = None, lstat: Callable[[str], Any] = os.lstat,
            out: Callable[[str], None] = print, clock: Callable[[], float] = time.time) -> int:
    """`run <job id>`: one job, only inside the transient unit start_job made for it (its name is in
    /proc/self/cgroup), under the one-job lock, with a power hold for as long as it runs; its outcome goes into its
    record. 0 when it ran (whatever its outcome), 2 when refused."""
    helper = Helper(paths, system, lstat, clock=clock, environ={})
    try:
        helper.installation()
    except Refused as exc:
        out(f"Refused ({exc.code}): {exc.words}")
        return 2
    jobs = f"{paths.state}/jobs"
    record = helper._read_record(jobs, job + ".json")
    if record is None or record.get("verb") not in JOB_VERBS or record.get("state") != "starting":
        out("Refused: there is no job waiting to run under that id.")
        return 2
    unit = unit_name(record["verb"], job)
    cgroup = helper._text(paths.at("/proc/self/cgroup"))
    if f"/{unit}.service" not in cgroup:
        out("Refused: a job runs only inside its own unit.")
        return 2
    os.makedirs(paths.at(RUN_DIR), mode=0o700, exist_ok=True)
    lock = os.open(f"{paths.at(RUN_DIR)}/job.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(lock)
        record.update(state="ended", outcome="busy", ended=now_iso(clock()))
        helper._write_record(jobs, job + ".json", record)
        return 0
    spec = JOB_VERBS[record["verb"]]
    hold = f"{paths.holds}/system-{job}.json"
    log = f"{paths.state}/runs/{job}/out"

    def write(text: str) -> None:
        os.makedirs(os.path.dirname(log), mode=0o700, exist_ok=True)
        fd = os.open(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as handle:
            handle.write(text)

    try:
        with contextlib.suppress(OSError):
            os.makedirs(paths.holds, mode=0o755, exist_ok=True)
            helper._write_record(paths.holds, f"system-{job}.json", {
                "id": job, "holder": "system", "why": spec["why"], "until": now_iso(clock() + spec["hold_minutes"] * 60),
                "max_delay_minutes": 0, "resources": []})
            os.chmod(hold, 0o644)
        record.update(state="running", started=now_iso(clock()))
        helper._write_record(jobs, job + ".json", record)
        try:
            result = getattr(helper, "job_" + record["verb"].replace(".", "_"))(record, write)
        except Exception as exc:  # noqa: BLE001 - the job's failure is its outcome, in one line
            result = {"outcome": "failed", "first_error": f"Seraphina's system access failed ({type(exc).__name__})"}
        record.update(state="ended", ended=now_iso(clock()), **result)
        helper._write_record(jobs, job + ".json", record)
    finally:
        with contextlib.suppress(OSError):
            os.unlink(hold)
        os.close(lock)
    return 0


def main(argv: list[str] | None = None, stdin: Any = None, stdout: Any = None, paths: Paths | None = None,
         system: System | None = None, lstat: Callable[[str], Any] = os.lstat,
         execv: Callable[[str, list[str]], Any] = os.execv, environ: dict | None = None) -> int:
    """No arguments: one request from standard input. `setup <staged config>`, `remove`, `explain
    helper-config|ingress|access`, `run <job id>` (inside its own unit only). Anything else is refused (so a
    misconfigured sudoers file still opens nothing more)."""
    argv = sys.argv[1:] if argv is None else argv
    stdin = stdin or sys.stdin.buffer
    stdout = stdout or sys.stdout
    paths = paths or Paths()
    environ = os.environ if environ is None else environ
    os.umask(0o077)

    def say(text: str) -> None:
        print(text, file=stdout)

    if argv[:1] == ["explain"] and len(argv) == 2 and argv[1] in ("helper-config", "ingress", "access"):
        return explain(argv[1], paths, system, lstat, out=say)
    if argv[:1] == ["run"] and len(argv) == 2 and JOB_RE.fullmatch(argv[1]):
        return run_job(argv[1], paths, system, lstat, out=say)
    if argv[:1] == ["setup"] and len(argv) == 2:
        return setup(argv[1], paths, system, lstat, environ, out=say)
    if argv == ["remove"]:
        return remove(paths, system, environ, lstat, out=say)
    if not argv and not environ.get("INVOCATION_ID") and wants_pid1(paths, lstat):
        stdout.flush()
        execv(SYSTEMD_RUN, [*PID1_ARGV, f"--setenv=SUDO_UID={environ.get('SUDO_UID', '')}", paths.helper, "inner"])
        return 1
    if argv == ["inner"] and environ.get("INVOCATION_ID"):
        argv = []
    if argv:
        later = argv[0] in ("enrol", "approve", "confirm") or argv[:2] in (["explain", "approval"],
                                                                           ["explain", "ticket"])
        words = ("that mode comes with a later version: this one changes nothing but the package lists and kept names"
                 if later else "the helper takes no arguments but setup, remove, run <job> or explain "
                               "helper-config|ingress|access")
        stdout.write(json.dumps({"ok": False, "error": "not_in_this_version" if later else "bad_arguments",
                                 "words": f"Refused: {words}."}) + "\n")
        return 2
    line = stdin.readline(MAX_REQUEST + 2)
    code, answer = Helper(paths, system, lstat, environ=environ).handle(line)
    stdout.write(json.dumps(answer, ensure_ascii=True, separators=(",", ":")) + "\n")
    return code


if __name__ == "__main__":
    sys.exit(main())
